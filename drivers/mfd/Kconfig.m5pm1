# MFD_M5PM1 itself is deliberately NOT defined here. Zephyr PR #109961 landed
# upstream on 2026-06-03 and brings the M5PM1 MFD, GPIO and ADC drivers with
# the same compatibles, the same `zephyr/drivers/mfd/m5pm1.h` and the same
# Kconfig symbol names this tree used to vendor, so defining MFD_M5PM1 again
# out-of-tree would give the symbol two definitions in one Kconfig tree.
#
# What upstream does NOT ship is an emulator, and tests/drivers/m5pm1_mfd
# needs one, so that one file stays here and keeps its own symbol.

config EMUL_M5PM1_MFD
	bool "M5Stack M5PM1 PMIC emulator (MFD path)"
	default y
	depends on EMUL
	depends on MFD_M5PM1
	help
	  I2C register-store emulator for the M5PM1 PMIC behind the
	  `m5stack,m5pm1` MFD parent node, for native_sim driver unit tests.
	  Backs the upstream mfd_m5pm1.c + gpio_m5pm1.c + adc_m5pm1.c (the
	  on-board path). Tests of the MFD path select this one.

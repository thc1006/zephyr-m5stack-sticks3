config AUDIO_CODEC_ES8311
	bool "Everest Semiconductor ES8311 audio codec"
	default y
	# The upstream copy carries no such dependency, because upstream sources this
	# file from inside `if AUDIO_CODEC`. Out of tree it is sourced at the top
	# level, so it has to state it.
	depends on AUDIO_CODEC
	depends on DT_HAS_EVEREST_ES8311_ENABLED
	select I2C
	help
	  Enable support for the Everest Semiconductor ES8311 mono audio codec
	  (I2C control, I2S/PCM data).
